{
  "name": "releasepace-js",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for ReleasePace feature flags",
  "homepage": "https://releasepace.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/releasepace/releasepace-js.git"
  },
  "bugs": {
    "url": "https://github.com/releasepace/releasepace-js/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts src/react.tsx --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": ["feature-flags", "feature-toggles", "releasepace", "typescript"],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesOptional": {
    "react": true
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "tsup": {
    "entry": ["src/index.ts", "src/react.tsx"],
    "format": ["cjs", "esm"],
    "dts": true,
    "external": ["react"]
  }
}
